{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--isolated",
        "--storage-state",
        "e2e/.auth/administrador.json",
        "--caps",
        "vision,network,devtools,testing,config",
        "--allowed-origins",
        "http://localhost:5173;http://localhost:8010;http://localhost:8000;https://fonts.googleapis.com;https://fonts.gstatic.com",
        "--viewport-size",
        "1440x900",
        "--snapshot-boxes",
        "--console-level",
        "warning",
        "--timeout-action",
        "10000",
        "--output-dir",
        "e2e-report/mcp",
        "--save-session"
      ]
    }
  }
}
